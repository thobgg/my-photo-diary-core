# ═══════════════════════════════════════════════════════════════════════
#  My Photo Diary — mpd.env.example
#  Jeder Schalter, den der Server kennt, mit seiner Vorgabe. Die Wahrheit
#  ist backend/config.py; diese Datei ist die lesbare Liste dazu.
#
#  Benutzung: nach mpd.env kopieren und NUR die Zeilen setzen, die vom
#  Standard abweichen sollen. Was fehlt, bekommt die Vorgabe — ein
#  Tippfehler im Namen faellt nicht auf, der Standard greift still.
#  Werte: "1" = an, "0" = aus (nicht "true"/"yes").
#  mpd.env liegt im Repo-Stamm, ist gitignored und wird nur beim Start
#  gelesen — Aenderungen brauchen `docker compose restart`.
# ═══════════════════════════════════════════════════════════════════════

# ── Pfade (Synology-Vorgaben; im SPK setzt sie der Assistent) ──────────
#MPD_PHOTO_SHARED=/volume1/photo          # Familienbestand
#MPD_HOMES_ROOT=/volume1/homes            # Wurzel der persoenlichen Bereiche
#MPD_PERSONAL_SUBDIR=Photos               # <home>/<Unterordner> je Konto
#MPD_STATE_DIR=<Ordner von config.py>     # Log + Suchindex (SPK: /var/…/state)
#MPD_THUMB_CACHE_DIR=/data/thumb-cache
#MPD_USERS_JSON=/data/users.json
#MPD_SESSION_DB=/data/mpd.sqlite          # Sitzungen, Freigaben, Adressbuch
#MPD_NOTIFY_DB=/data/mpd-notify.sqlite    # Benachrichtigungen
#MPD_TRAILS_DIR=/data/trails              # eine SQLite je Konto
#MPD_IMPORT_DIR=/data/import              # Einlieferungsordner (Google-Zeitachse)
#MPD_LICENSE_FILE=/data/mpd-license.json

# ── Erreichbarkeit ─────────────────────────────────────────────────────
#MPD_BASE_URL=                            # https://mpd.example.org — fuer Freigabelinks,
                                          # Mails, QR; leer = aus dem Request abgeleitet

# ── Demo-Zugang (nur fuer eine Schau-Installation, Vorgabe AUS) ────────
#MPD_DEMO=0                               # 1 = /demo-login existiert und ist oeffentlich
#MPD_DEMO_USER=mpd-demo
#MPD_DEMO_PASSWORD=                       # Pflicht, wenn MPD_DEMO=1

# ── Benachrichtigungen (NAS-Skripte ohne Sitzung) ──────────────────────
#MPD_NOTIFY_PUBLISH_TOKEN=                # leer = POST /api/notify/publish gibt es nicht

# ── Memories ───────────────────────────────────────────────────────────
#MEMORIES_HOUR=6                          # taeglicher „Heute vor …"-Job
#MEMORIES_MINUTE=30

# ── Vorschau-Zwischenspeicher ──────────────────────────────────────────
#MPD_WARMER=1                             # 0 = Vorwaermen ganz aus. Thumbnails
                                          # entstehen dann beim ersten Ansehen.
                                          # Fuer sehr kleine NAS und fuer
                                          # Entwicklungsinstanzen, die den
                                          # Fotobestand nur eingehaengt haben.
#MPD_WARMER_THREADS=3                     # 1–8; kleine NAS: 2
#MPD_THUMB_SWEEP=0                        # 1 = verwaiste Vorschaubilder nachts loeschen
                                          # (0 = nur melden, Trockenlauf im Log)
#MPD_THUMB_SWEEP_GRACE_DAYS=7             # Schonfrist fuer frisch Erzeugtes

# ── Nachtlauf / Verfallsregeln ─────────────────────────────────────────
#MPD_RETENTION_HOUR=3                     # Aufraeumen (Sicherungspunkte, Kehren, Meldungen)
#MPD_RETENTION_MINUTE=30
#MPD_ALBUM_BACKUP_KEEP=10                 # album.json-Staende je Album
#MPD_TRAILS_SNAPSHOT_KEEP=3               # Trails-Sicherungspunkte je Konto …
#MPD_TRAILS_SNAPSHOT_DAYS=90              # … und Hoechstalter (0 = ohne Grenze)

# ── Rettungskopie ──────────────────────────────────────────────────────
# Beim Deinstallieren entfernt der Docker-Worker den ganzen Datenordner.
# Deshalb liegt das Unersetzliche zusaetzlich dort, wo DSM nicht hinlangt:
# der Standortverlauf im persoenlichen Foto-Ordner der jeweiligen Person,
# Konten und Zugangsschluessel im Ordner des Admins — je in einem
# Unterordner mit fuehrendem Punkt, den MPD ueberall ueberspringt.
# Der Vorschau-Zwischenspeicher bleibt aussen vor: neu berechenbar.
#MPD_KEEP=1                               # 0 = keine Rettungskopie
#MPD_KEEP_HOUR=2                          # bewusst VOR Aufraeumen und Trails-Lauf
#MPD_KEEP_MINUTE=30
#MPD_KEEP_SNAPSHOTS=1                     # Staende je Konto; jeder kostet die
                                          # volle Groesse des Stores
#MPD_KEEP_SNAPSHOT_DAYS=7                 # wie oft ein frischer Stand gezogen
                                          # wird. Die Monatsdateien wandern
                                          # jede Nacht mit; die ganze Datenbank
                                          # kostet Schreiblast und aendert sich
                                          # in einer Woche kaum. 0 = taeglich
#MPD_KEEP_DIR_NAME=.mpd-keep              # fuehrender Punkt ist Pflicht

# ── Trails (Standorthistorie) ──────────────────────────────────────────
#MPD_TRAILS_EXPORT_HOUR=4                 # Monatsexport → Ableitung → Ortsnamen
#MPD_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
                                          # eigene Instanz = keine Drosselung; leer = Benennen aus
#MPD_GEOCODE_INTERVAL_S=15                # Takt je Abfrage (oeffentliches Nominatim: nicht unter 15)
#MPD_GEOCODE_NIGHTLY=360                  # Abfragen je Lauf (Start + naechtlich)
#MPD_GEOCODE_LANG=de

# ── Module / Lizenz ────────────────────────────────────────────────────
#MPD_LICENSE_ENFORCE=0                    # 1 = Module nur mit gueltiger Lizenzdatei
                                          #     (das Plus-Paket setzt es; Notausgang:
                                          #      hier 0 setzen, Paket neu starten)
#MPD_LICENSE_GRACE_DAYS=30                # Karenz nach dem Ablaufdatum; 0 = hart

# ── Mailversand (Rueckfall; die Einstellungen im Admin-Dialog gewinnen) ─
#MPD_SMTP_HOST=
#MPD_SMTP_PORT=587
#MPD_SMTP_USER=
#MPD_SMTP_PASS=
#MPD_FROM_ADDR=
#MPD_FROM_NAME=My Photo Diary

# ── Companion (Rueckfall; Schluessel und Anbieter stehen im Admin-Dialog) ─
#ANTHROPIC_API_KEY=
#COMPANION_MODEL=claude-haiku-4-5-20251001

# ── Nur noch fuer die Laenderkennung der Fotostatistik ─────────────────
#MAPTILER_KEY=                            # leer = Laenderstatistik ohne Namen
