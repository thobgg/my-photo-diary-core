#!/bin/sh
. "$(dirname "$0")/common"
log "preinst"
if [ "${SYNOPKG_PKG_STATUS}" = "INSTALL" ]; then
    [ -n "${wizard_photo_share:-}" ] || die "Bitte den Namen der Freigabe mit den gemeinsamen Fotos angeben."
    [ -e "${VOL_BASE}/${wizard_photo_share}" ] || die "Freigabe nicht gefunden: ${VOL_BASE}/${wizard_photo_share} (Name wie in der Systemsteuerung, Groß-/Kleinschreibung beachten)"
    lan="${wizard_port:-${DEFAULT_LAN_PORT}}"
    port_valid "${lan}" || die "Ungültiger LAN-Port: ${lan}"
    port_in_use "${lan}" && die "Port ${lan} ist bereits belegt."

    # Konten: Ein Admin ist Pflicht — es sei denn, am Zielort liegen schon Daten. Das ist der
    # Umstieg und die Wiederherstellung nach NAS-Tausch: users.json ist bereits kopiert, im
    # Assistenten steht dann zu Recht ueberall "nicht anlegen". Die Datei gehoert root und ist
    # 0600; der Paketnutzer kann nur sehen, DASS sie da ist, nicht hineinschauen.
    if [ -f "${DOCKER_DATA}/users.json" ]; then
        log "Bestehende users.json unter ${DOCKER_DATA} gefunden — keine Erstkonten noetig"
    else
        admins="$(local_users | { n=0; while read -r u; do k="$(user_key "${u}")"; eval "sel=\${wizard_role_${k}_admin:-}"; [ "${sel}" = "true" ] && n=$((n+1)); done; echo ${n}; })"
        [ "${admins}" -gt 0 ] || die "Mindestens ein Konto muss die Rolle Admin bekommen — oder es liegen bereits Daten einer früheren Installation unter ${DOCKER_DATA}."
    fi

    # Startpasswort nur verlangen, wenn wirklich ein Admin angelegt werden soll.
    neue_admins="$(local_users | { n=0; while read -r u; do k="$(user_key "${u}")"; eval "sel=\${wizard_role_${k}_admin:-}"; [ "${sel}" = "true" ] && n=$((n+1)); done; echo ${n}; })"
    if [ "${neue_admins}" -gt 0 ]; then
        [ "${#wizard_pw_admin}" -ge 12 ] || die "Für neue Admin-Konten braucht es ein Startpasswort mit mindestens 12 Zeichen."
    fi
    if [ -n "${wizard_pw_other:-}" ] && [ "${#wizard_pw_other}" -lt 12 ]; then
        die "Das Passwort für Editor/Viewer braucht mindestens 12 Zeichen (oder leer lassen)."
    fi
fi
exit 0
