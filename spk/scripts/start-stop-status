#!/bin/sh
# Starten/Stoppen erledigt der Docker-Worker des Container Managers (conf/resource).
. "$(dirname "$0")/common"
case "$1" in
    # prestart läuft vor dem Start-Worker (docker-compose up): erst hier dürfen die Mount-Symlinks
    # aus dem Paket hinauszeigen — der Install-Worker prüft Pfade und lehnt Symlinks ab.
    prestart) apply_mounts "$(wiz_get wizard_photo_share)" "$(wiz_get wizard_homes_root)" "$(wiz_get wizard_personal_subdir)"; exit 0 ;;
    prestop)  exit 0 ;;
    start)  log "start (Worker)"; exit 0 ;;
    stop)   log "stop (Worker)";  exit 0 ;;
    status) container_running; exit $? ;;
    log)    echo "${LOG}"; exit 0 ;;
    *)      exit 1 ;;
esac
