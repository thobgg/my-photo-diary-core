startable="yes"
ctl_stop="yes"
ctl_uninstall="yes"
precheckstartstop="yes"
adminprotocol="http"
adminport="__LAN_PORT__"
adminurl="/"
checkport="no"
dsmuidir="ui"
dsmappname="SYNO.SDS.MPD.Application"
thirdparty="yes"
silent_install="no"
silent_upgrade="no"
silent_uninstall="no"
extractsize="__EXTRACTSIZE__"
