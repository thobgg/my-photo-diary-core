package="MPD"
displayname="__DISPLAYNAME__"
displayname_ger="__DISPLAYNAME__"
version="__VERSION__"
description="Self-hosted photo diary: albums with text, maps and tours, shared with your family. Runs as a container via Container Manager."
description_ger="Selbstgehostetes Foto-Tagebuch: Alben mit Text, Karten und Touren, geteilt mit der Familie. Läuft als Container über den Container Manager."
maintainer="Thomas Bugge"
